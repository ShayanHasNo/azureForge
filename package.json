{
  "name": "the-quiet-forge",
  "private": true,
  "version": "0.1.0",
  "description": "A cozy pixel-art blacksmithing, crafting and mastery game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/balance.test.ts",
    "e2e": "vite build && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "redis": "^6.3.1"
  }
}
